# Copy to .env and adjust. `podman compose` reads it automatically.

# The i18n folder (the one with rcinel-translate.json) of the app you translate.
RCINEL_PROJECT=./samples/demo/i18n
RCINEL_PORT=8080

# Creates this admin on the first start. Leave empty to use the setup link from `podman compose logs editor` instead.
RCINEL_ADMIN_USER=admin
RCINEL_ADMIN_PASSWORD=

# For AI drafts. Get a key at https://platform.claude.com
ANTHROPIC_API_KEY=

# Only for Docker (rootful): your uid:gid, so files in RCINEL_PROJECT stay yours. Not needed with rootless Podman.
# RCINEL_USER=1000:1000
