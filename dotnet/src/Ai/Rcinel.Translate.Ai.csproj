<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Drafts translations with Claude. Its own assembly so the netstandard2.0 Core stays free of the
    Anthropic SDK, and both the editor and `rcinel draft` share one prompt.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <AssemblyName>Rcinel.Translate.Ai</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="13.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Rcinel.Translate.Core.csproj" />
    <InternalsVisibleTo Include="Rcinel.Translate.Editor.Tests" />
  </ItemGroup>

</Project>
