<Project Sdk="Microsoft.NET.Sdk">

  <!-- `dotnet tool install -g Rcinel.Translate.Cli` gives the `rcinel` command. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>rcinel</ToolCommandName>
    <PackageId>Rcinel.Translate.Cli</PackageId>
    <AssemblyName>rcinel</AssemblyName>
    <Description>The rcinel command: create ids, scan code for Rcinel.Translate calls, show progress, check and export translations, draft them with AI.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Rcinel.Translate.Core.csproj" />
    <ProjectReference Include="..\Ai\Rcinel.Translate.Ai.csproj" />
    <InternalsVisibleTo Include="Rcinel.Translate.Cli.Tests" />
  </ItemGroup>

</Project>
